{
    "type": "phpcodesniffer-standard",
    "name": "phpmath/coding-standard",
    "description": "The coding standards for PHP_CodeSniffer we use at phpmath",
    "homepage": "https://github.com/phpmath",
    "license": "MIT",
    "authors": [
        {
            "name": "Walter Tamboer",
            "homepage": "https://waltertamboer.nl",
            "role": "Developer"
        }
    ],
    "keywords": [
        "phpmath",
        "coding-standard",
        "coding-standards",
        "coding",
        "standard",
        "standards",
        "cs",
        "code",
        "style",
        "sniffer",
        "rules",
        "sniffs",
        "checks"
    ],
    "require": {
        "php": "^8.4",
        "doctrine/coding-standard": "^14.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "sh tests/check-ruleset.sh"
    }
}
